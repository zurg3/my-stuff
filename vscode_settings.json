{
  "breadcrumbs.enabled": false,
  "editor.accessibilitySupport": "off",
  "editor.autoIndent": "full",
  "editor.autoIndentOnPaste": true,
  "editor.bracketPairColorization.enabled": false,
  "editor.colorDecorators": false,
  "editor.colorDecoratorsActivatedOn": "click",
  "editor.folding": true,
  "editor.fontFamily": "Menlo, Consolas, 'DejaVu Sans Mono', monospace",
  "editor.fontSize": 13,
  "editor.guides.indentation": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.insertSpaces": true,
  "editor.lineHeight": 1.45,
  "editor.lineNumbers": "on",
  "editor.links": true,
  "editor.matchBrackets": "near",
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.occurrencesHighlight": "off",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "none",
  "editor.rulers": [80],
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollBeyondLastLine": false,
  "editor.selectionHighlight": false,
  "editor.showDeprecated": false,
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "explorer.compactFolders": false,
  "extensions.autoUpdate": false,
  "files.autoSave": "off",
  "files.enableTrash": false,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "remoteHub.commitDirectlyWarning": "off",
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "window.autoDetectColorScheme": false,
  "window.autoDetectHighContrast": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "classic",
  "workbench.activityBar.location": "hidden",
  "workbench.colorTheme": "Atom One Dark",
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.enablePreview": false,
  "workbench.editor.restoreViewState": false,
  "workbench.editor.showIcons": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "fixed",
  "workbench.editor.tabSizingFixedMaxWidth": 260,
  "workbench.editor.tabSizingFixedMinWidth": 80,
  "workbench.editor.useModal": "off",
  "workbench.iconTheme": "vs-minimal",
  "workbench.layoutControl.enabled": false,
  "workbench.list.openMode": "doubleClick",
  "workbench.navigationControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "none"
}
